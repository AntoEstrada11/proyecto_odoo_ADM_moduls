<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_rating_score_help_wizard_form" model="ir.ui.view">
        <field name="name">partner.rating.score.help.wizard.form</field>
        <field name="model">partner.rating.score.help.wizard</field>
        <field name="arch" type="xml">
            <form string="Cómo se calcula la calificación">
                <field name="rating_id" invisible="1"/>
                <field name="rating_state" invisible="1"/>
                <group string="Resultado actual">
                    <group>
                        <field name="viability_percent" widget="progressbar"/>
                        <field name="performance_percent" widget="progressbar"/>
                        <field name="score_percent" widget="progressbar"/>
                    </group>
                    <group string="Ponderación (debe sumar 100)">
                        <field name="weight_viability" readonly="rating_state == 'done'"/>
                        <field name="weight_performance" readonly="rating_state == 'done'"/>
                    </group>
                </group>
                <separator string="Detalle del cálculo"/>
                <field name="explanation" nolabel="1"/>
                <footer>
                    <button
                        name="action_apply_weights"
                        type="object"
                        string="Guardar ponderación"
                        class="btn-primary"
                        invisible="rating_state == 'done'"
                    />
                    <button string="Cerrar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
