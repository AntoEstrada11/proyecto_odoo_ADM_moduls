<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_rating_list" model="ir.ui.view">
        <field name="name">res.partner.form.rating.list</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="partner_documents.view_partner_form_documents"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='supplier_qualification']" position="inside">
                <separator string="Resumen de evaluación"/>
                <div invisible="has_rating" class="text-muted mb-2">
                    Este contacto aún no tiene evaluación en Calificadora.
                </div>
                <group invisible="not has_rating">
                    <group string="Estatus">
                        <field name="has_rating" invisible="1"/>
                        <field name="rating_id" invisible="1"/>
                        <field name="rating_summary_date"/>
                        <field name="rating_summary_state"/>
                        <field name="rating_summary_level"/>
                        <field name="rating_summary_risk"/>
                        <field name="rating_summary_analysis"/>
                    </group>
                    <group string="Porcentajes">
                        <field name="rating_viability_percent" widget="progressbar"/>
                        <field name="rating_performance_percent" widget="progressbar"/>
                        <field name="rating_global_percent" widget="progressbar"/>
                    </group>
                </group>
                <group groups="partner_rating.group_evaluation_user">
                    <div>
                        <button
                            name="action_open_partner_rating"
                            type="object"
                            class="btn-primary"
                            string="Abrir evaluación"
                            invisible="not has_rating"
                        />
                        <button
                            name="action_open_partner_rating"
                            type="object"
                            class="btn-secondary"
                            string="Crear evaluación"
                            invisible="has_rating"
                        />
                    </div>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_partner_rating_tree" model="ir.ui.view">
        <field name="name">partner.rating.tree</field>
        <field name="model">partner.rating</field>
        <field name="arch" type="xml">
            <tree string="Evaluaciones de proveedores">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="company_type"/>
                <field name="date"/>
                <field name="analysis_status"/>
                <field name="viability_percent" widget="progressbar"/>
                <field name="performance_percent" widget="progressbar"/>
                <field name="score_percent" widget="progressbar"/>
                <field name="rating_level"/>
                <field name="risk_level"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="view_partner_rating_form" model="ir.ui.view">
        <field name="name">partner.rating.form</field>
        <field name="model">partner.rating</field>
        <field name="arch" type="xml">
            <form string="Gestión de Proveedores - Evaluación">
                <header>
                    <button
                        name="action_open_partner"
                        type="object"
                        string="Editar datos / documentos del contacto"
                        class="btn-secondary"
                    />
                    <button
                        name="action_load_checklist"
                        type="object"
                        string="Cargar checklist"
                        class="btn-secondary"
                    />
                    <button
                        name="action_reload_checklist"
                        type="object"
                        string="Regenerar checklist documental"
                        invisible="not document_line_ids or state == 'done'"
                        class="btn-secondary"
                        confirm="Se borrará el checklist documental actual y se creará de nuevo según Moral/Física. ¿Continuar?"
                    />
                    <button
                        name="action_set_done"
                        type="object"
                        string="Finalizar"
                        invisible="state == 'done'"
                        class="btn-primary"
                    />
                    <button
                        name="action_set_draft"
                        type="object"
                        string="Volver a borrador"
                        invisible="state == 'draft'"
                    />
                    <field name="state" widget="statusbar" statusbar_visible="draft,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_open_score_help"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-percent"
                        >
                            <div class="o_stat_info">
                                <span class="o_stat_text">Cómo se</span>
                                <span class="o_stat_text">calcula el %</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" string="Evaluación"/>
                        <h1>
                            <field name="name" placeholder="Referencia de evaluación"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Proveedor">
                            <field name="partner_id" readonly="id"/>
                            <field name="company_type"/>
                            <field name="date"/>
                            <field name="rating_level"/>
                            <field name="risk_level"/>
                        </group>
                        <group string="Calificaciones">
                            <field name="viability_percent" widget="progressbar"/>
                            <field name="performance_percent" widget="progressbar"/>
                            <field name="score_percent" widget="progressbar"/>
                            <field name="weight_viability" invisible="1"/>
                            <field name="weight_performance" invisible="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="1. Datos del contacto" name="qualification">
                            <div class="alert alert-info" role="alert">
                                Solo se muestran los datos aplicables al tipo de persona del contacto.
                            </div>
                            <group string="Identificación">
                                <group>
                                    <field name="company_name"/>
                                    <field name="vat"/>
                                    <field name="bank_name"/>
                                    <field name="bank_account"/>
                                </group>
                            </group>

                            <group string="Persona Física" invisible="company_type != 'fisica'">
                                <group>
                                    <field name="official_id"/>
                                    <field name="curp"/>
                                </group>
                            </group>

                            <group string="Persona Moral" invisible="company_type != 'moral'">
                                <group>
                                    <field name="legal_representative"/>
                                    <field name="legal_representative_id"/>
                                    <field name="opening_date"/>
                                    <field name="social_capital"/>
                                    <field name="imss_number"/>
                                    <field name="infonavit_number"/>
                                </group>
                                <group>
                                    <field name="contractual_object"/>
                                    <field name="corporate_structure"/>
                                </group>
                            </group>
                        </page>

                        <page string="2. Criterios internos" name="criteria">
                            <group>
                                <field name="meets_internal_criteria" widget="radio"/>
                                <field name="analysis_status" widget="radio"/>
                                <field name="status_reason" placeholder="Razón de estatus..."/>
                            </group>
                        </page>

                        <page string="3. Documentos evaluados" name="documents">
                            <p class="text-muted">
                                Parte de la viabilidad jurídica / documental.
                                Puntaje: No recibido 0 · Recibido 1 · Aprobado 2.
                            </p>
                            <field name="document_line_ids" nolabel="1">
                                <tree editable="bottom" create="0" delete="0">
                                    <field name="sequence" widget="handle"/>
                                    <field name="document_type_id" optional="hide"/>
                                    <field name="name"/>
                                    <field name="person_type"/>
                                    <field name="situation"/>
                                    <field name="partner_document_id"/>
                                    <field name="warnings"/>
                                </tree>
                            </field>
                            <group>
                                <field name="documents_notes"/>
                                <field name="post_hire_notes"/>
                            </group>
                        </page>

                        <page string="4. Averiguaciones" name="research">
                            <p class="text-muted">
                                Parte de la viabilidad jurídica / documental
                                (investigaciones en portales: SAT, buró, domicilio, etc.).
                                Puntaje: Pendiente 0 · Realizada 1 · Favorable 2 · Con hallazgos 0.
                            </p>
                            <field name="research_line_ids" nolabel="1">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="situation"/>
                                    <field name="warnings"/>
                                    <field name="notes" optional="show"/>
                                    <field name="evidence_filename" column_invisible="1"/>
                                    <field name="evidence" filename="evidence_filename" widget="binary"/>
                                </tree>
                            </field>
                            <group>
                                <field name="research_notes"/>
                            </group>
                        </page>

                        <page string="5. Desempeño comercial" name="performance">
                            <div class="alert alert-info" role="alert">
                                Este porcentaje ya no se captura aquí.
                                Se calcula con el historial de compras finalizadas
                                (Eval. Compras), calificando en cada compra:
                                Precio, Calidad, Entrega, Atención y Cumplimiento.
                                Las averiguaciones (SAT, buró, etc.) forman parte
                                de la viabilidad jurídica / documental.
                            </div>
                            <group>
                                <field name="purchase_evaluation_count"/>
                                <field name="performance_percent" widget="progressbar"/>
                            </group>
                            <button
                                name="action_open_purchase_evaluations"
                                type="object"
                                string="Ver historial de compras evaluadas"
                                class="btn-primary"
                            />
                            <group>
                                <field name="performance_notes" placeholder="Notas generales del desempeño del proveedor..."/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_partner_rating" model="ir.actions.act_window">
        <field name="name">Evaluaciones</field>
        <field name="res_model">partner.rating</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="menu_partner_rating_root"
        name="Calificadora"
        sequence="90"
        groups="partner_rating.group_evaluation_user"
    />
    <menuitem
        id="menu_partner_rating"
        name="Evaluaciones"
        parent="menu_partner_rating_root"
        action="action_partner_rating"
        sequence="10"
        groups="partner_rating.group_evaluation_user"
    />
</odoo>
