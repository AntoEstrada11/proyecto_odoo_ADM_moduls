<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_evaluation_access" model="ir.ui.view">
        <field name="name">res.users.form.evaluation.access</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Evaluaciones" name="evaluations_access">
                    <group string="Módulos de evaluación">
                        <field name="can_access_calificadora"/>
                        <field name="can_access_purchase_evaluation"/>
                    </group>
                    <p class="text-muted">
                        Activa cada bandera según el módulo que deba ver el usuario
                        en el menú de aplicaciones.
                        La visibilidad de documentos confidenciales se administra
                        aparte (pestaña Documentos proveedor del usuario).
                    </p>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
