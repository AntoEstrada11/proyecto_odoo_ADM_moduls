<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_order_form_evaluation" model="ir.ui.view">
        <field name="name">purchase.order.form.purchase.evaluation</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button
                    name="action_open_purchase_evaluations"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-check-square-o"
                    invisible="purchase_evaluation_count == 0"
                    groups="purchase_evaluation.group_purchase_evaluation_user"
                >
                    <field name="purchase_evaluation_count" widget="statinfo" string="Eval. compra"/>
                </button>
                <button
                    name="action_create_purchase_evaluation"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-plus"
                    invisible="purchase_evaluation_count != 0"
                    string="Crear eval. compra"
                    groups="purchase_evaluation.group_purchase_evaluation_user"
                />
            </div>
        </field>
    </record>
</odoo>
