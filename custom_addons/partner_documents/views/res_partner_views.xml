<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_document_tree" model="ir.ui.view">
        <field name="name">partner.document.tree</field>
        <field name="model">partner.document</field>
        <field name="arch" type="xml">
            <tree string="Documentos">
                <field name="image_preview" widget="image" options="{'size': [48, 48]}"/>
                <field name="document_type_id" optional="show"/>
                <field name="name" string="Nombre del documento"/>
                <field name="person_type" optional="hide"/>
                <field name="file_name"/>
                <field name="mimetype" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="view_partner_document_form" model="ir.ui.view">
        <field name="name">partner.document.form</field>
        <field name="model">partner.document</field>
        <field name="arch" type="xml">
            <form string="Documento">
                <sheet>
                    <group>
                        <group>
                            <field name="document_type_id"/>
                            <field name="name" string="Nombre del documento"/>
                            <field name="person_type"/>
                            <field name="file_name" invisible="1"/>
                            <field name="file" filename="file_name" widget="binary"/>
                            <field name="mimetype" readonly="1"/>
                        </group>
                        <group>
                            <field name="is_image" invisible="1"/>
                            <field name="is_pdf" invisible="1"/>
                            <field name="is_excel" invisible="1"/>
                            <field name="image_preview" widget="image" invisible="not is_image"/>
                            <field name="file" widget="pdf_viewer" filename="file_name" invisible="not is_pdf"/>
                            <div invisible="not is_excel" class="text-muted">
                                Vista previa no disponible para archivos Excel.
                            </div>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_partner_form_documents" model="ir.ui.view">
        <field name="name">res.partner.form.documents</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='internal_notes']" position="after">
                <page string="Documentos" name="partner_documents">
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_open_document_upload_wizard"
                            type="object"
                            class="btn-primary"
                            string="Subir documento"
                        />
                    </div>
                    <p class="text-muted">
                        Los documentos disponibles dependen de si el contacto es
                        Individual (Física) o Empresa (Moral). También puede
                        subir documentos con nombre personalizado (tipo «Otro»).
                    </p>
                    <field name="document_ids" nolabel="1" readonly="1">
                        <tree>
                            <field name="image_preview" widget="image" options="{'size': [48, 48]}"/>
                            <field name="document_type_id" optional="show"/>
                            <field name="name" string="Nombre del documento"/>
                            <field name="person_type" optional="hide"/>
                            <field name="file_name"/>
                        </tree>
                    </field>
                </page>
            </xpath>
            <xpath expr="//page[@name='internal_notes']" position="before">
                <page string="Datos de proveedor" name="supplier_qualification">
                    <group>
                        <group string="Identificación común">
                            <field name="vat" string="RFC"/>
                            <field name="rating_company_type" readonly="1"/>
                            <field name="bank_name"/>
                            <field name="bank_account"/>
                        </group>
                    </group>

                    <!-- PERSONA FÍSICA -->
                    <group string="Datos Persona Física" invisible="rating_company_type != 'fisica'">
                        <group>
                            <field name="official_id"/>
                            <field name="curp"/>
                        </group>
                    </group>

                    <!-- PERSONA MORAL -->
                    <group string="Datos Persona Moral" invisible="rating_company_type != 'moral'">
                        <group>
                            <field name="legal_representative"/>
                            <field name="legal_representative_id"/>
                            <field name="opening_date"/>
                            <field name="social_capital"/>
                            <field name="imss_number"/>
                            <field name="infonavit_number"/>
                        </group>
                        <group>
                            <field name="contractual_object"/>
                            <field name="corporate_structure"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
